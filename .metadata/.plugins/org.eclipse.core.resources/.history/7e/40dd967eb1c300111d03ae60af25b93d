package com;

import java.util.concurrent.locks.Lock;
import java.util.concurrent.locks.ReentrantLock;

class parent{
	Lock lock = new ReentrantLock();

    public void method() {
    	
        //lock.lock();
        if(lock.tryLock()) {
        	System.out.println("This is inside trylock");
        try {
            System.out.println(Thread.currentThread().getName());

            Thread.sleep(5000);
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        } finally {
            lock.unlock();
        }
        }
        else {
        	System.out.println("This is outside trylock");
        }
    }
}
class Mythread extends Thread {
	parent p;
	Mythread(String name,parent p){
		
		super(name);
		this.p=p;
	}
	public void run() {
		System.out.println("This is inside run");
		try 
		{
			p.method();
		}
		catch(Exception e) {
			
		}
	}
}
